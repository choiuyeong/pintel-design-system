<!--
  Pintel.Button.xaml  (Actions > Button)
  ─────────────────────────────────────────────────────────────
  DevExpress WPF SimpleButton 용 핀텔 버튼 스타일 4종.
  스펙: 높이 40 · radius 8 · padding 24,10 · Pretendard GOV 14 SemiBold · 상태 전이 Easing.Standard.
   - Pintel.Button.PrimarySolid    : 결정적 단일 액션
   - Pintel.Button.SecondarySolid  : 일반 동작(새로고침/목록보기)
   - Pintel.Button.PrimaryOutline  : 솔리드의 서브 동작(편집/필터)
   - Pintel.Button.SecondaryOutline: 취소/닫기/이전

  사용:  <dx:SimpleButton Content="분석 시작" Style="{StaticResource Pintel.Button.PrimarySolid}"/>
  (순정 WPF Button에 적용하려면 TargetType 을 Button 으로 바꾸면 됩니다.)
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Pintel.Tokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- 공통 템플릿: Border + ContentPresenter (Background/BorderBrush 는 컨트롤 속성에 바인딩) -->
    <ControlTemplate x:Key="Pintel.Button.BaseTemplate" TargetType="{x:Type dx:SimpleButton}">
        <Border x:Name="bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource Pintel.Radius.Md}"
                SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
        </Border>
    </ControlTemplate>

    <!-- 공통 베이스 스타일 -->
    <Style x:Key="Pintel.Button.Base" TargetType="{x:Type dx:SimpleButton}">
        <Setter Property="Height" Value="40"/>
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="Padding" Value="24,10"/>
        <Setter Property="FontFamily" Value="{StaticResource Pintel.Font}"/>
        <Setter Property="FontSize" Value="{StaticResource Pintel.Size.Label1}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource Pintel.Button.BaseTemplate}"/>
    </Style>

    <!-- 1) Primary Solid -->
    <Style x:Key="Pintel.Button.PrimarySolid" TargetType="{x:Type dx:SimpleButton}" BasedOn="{StaticResource Pintel.Button.Base}">
        <Setter Property="Background" Value="{StaticResource Pintel.Brush.Primary}"/>
        <Setter Property="Foreground" Value="{StaticResource Pintel.Brush.White}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Pintel.Brush.PrimaryStrong}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource Pintel.Brush.PrimaryHeavy}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Pintel.Brush.DisabledBg}"/>
                <Setter Property="Foreground" Value="{StaticResource Pintel.Brush.DisabledFg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 2) Secondary Solid -->
    <Style x:Key="Pintel.Button.SecondarySolid" TargetType="{x:Type dx:SimpleButton}" BasedOn="{StaticResource Pintel.Button.Base}">
        <Setter Property="Background" Value="{StaticResource Pintel.Brush.Neutral100}"/>
        <Setter Property="Foreground" Value="{StaticResource Pintel.Brush.Neutral800}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Pintel.Brush.Neutral200}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource Pintel.Brush.Neutral300}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Pintel.Brush.Neutral50}"/>
                <Setter Property="Foreground" Value="{StaticResource Pintel.Brush.Neutral300}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 3) Primary Outline -->
    <Style x:Key="Pintel.Button.PrimaryOutline" TargetType="{x:Type dx:SimpleButton}" BasedOn="{StaticResource Pintel.Button.Base}">
        <Setter Property="Background" Value="{StaticResource Pintel.Brush.White}"/>
        <Setter Property="Foreground" Value="{StaticResource Pintel.Brush.Primary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Pintel.Brush.Primary}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFEBF2FF"/>
                <Setter Property="BorderBrush" Value="{StaticResource Pintel.Brush.PrimaryStrong}"/>
                <Setter Property="Foreground" Value="{StaticResource Pintel.Brush.PrimaryStrong}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#FFDCE9FF"/>
                <Setter Property="BorderBrush" Value="{StaticResource Pintel.Brush.PrimaryHeavy}"/>
                <Setter Property="Foreground" Value="{StaticResource Pintel.Brush.PrimaryHeavy}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="BorderBrush" Value="{StaticResource Pintel.Brush.Neutral200}"/>
                <Setter Property="Foreground" Value="{StaticResource Pintel.Brush.Neutral300}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 4) Secondary Outline -->
    <Style x:Key="Pintel.Button.SecondaryOutline" TargetType="{x:Type dx:SimpleButton}" BasedOn="{StaticResource Pintel.Button.Base}">
        <Setter Property="Background" Value="{StaticResource Pintel.Brush.White}"/>
        <Setter Property="Foreground" Value="{StaticResource Pintel.Brush.Neutral800}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Pintel.Brush.Neutral200}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Pintel.Brush.Neutral50}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Pintel.Brush.Neutral300}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Pintel.Brush.Neutral100}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Pintel.Brush.Neutral400}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="BorderBrush" Value="{StaticResource Pintel.Brush.Neutral200}"/>
                <Setter Property="Foreground" Value="{StaticResource Pintel.Brush.Neutral300}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
